#!/usr/bin/env python3
"""Mock ``duckc`` compiler used by the test suite.

The real Duckling toolchain ships a ``duckc`` program that compiles source
files stored in ``.dmf`` files, producing an executable in a way similar to
``g++`` via the ``duckc compile <files/options>`` subcommand.

Since ``duckc`` is not available in the test environment, this mock treats the
contents of ``.dmf`` files as plain C++ source and forwards compilation to a
real C++ compiler (``g++`` / ``c++``). ``.dmf`` inputs are copied to temporary
``.cpp`` files so the C++ compiler picks the right language, and every other
argument (including ``-o <output>``) is passed through untouched.
"""
import os
import shutil
import subprocess
import sys
import tempfile


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] != "compile":
        sys.stderr.write("mock duckc: expected a `compile` subcommand\n")
        return 2

    forwarded = []
    tmpfiles = []
    try:
        for arg in argv[1:]:
            if arg.endswith(".dmf") and os.path.isfile(arg):
                fd, tmp = tempfile.mkstemp(suffix=".cpp")
                os.close(fd)
                shutil.copyfile(arg, tmp)
                tmpfiles.append(tmp)
                forwarded.append(tmp)
            else:
                forwarded.append(arg)

        cxx = shutil.which("g++") or shutil.which("c++")
        if cxx is None:
            sys.stderr.write("mock duckc: no C++ compiler found\n")
            return 1

        return subprocess.call([cxx, "--std=c++17", "-O2"] + forwarded)
    finally:
        for f in tmpfiles:
            try:
                os.remove(f)
            except OSError:
                pass


if __name__ == "__main__":
    sys.exit(main())
